{
  "name": "dsh-auto-send",
  "version": "1.3.4",
  "description": "Spot-send the composer draft later, off the peak-priced hours.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "fxm124578",
    "url": "https://github.com/fxm124578"
  },
  "homepage": "https://github.com/fxm124578/dsh-auto-send",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fxm124578/dsh-auto-send.git",
    "directory": "plugin"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "schedule",
    "delayed-send"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
